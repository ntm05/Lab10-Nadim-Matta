// Jenkinsfile_Nadim_Matta - EECE 435L Lab 10, Parts 3 and 4
// Stages: Setup -> Lint -> Test -> Coverage -> Security Scan -> Deploy
// Runs on a Linux agent (sh) or a Windows agent (bat).

// Run a command inside the project's virtual environment.
// Uses sh on Unix agents and bat on Windows agents.
def venv(String cmd) {
    if (isUnix()) {
        sh ". ${env.VIRTUAL_ENV}/bin/activate && ${cmd}"
    } else {
        bat "call ${env.VIRTUAL_ENV}\\Scripts\\activate.bat && ${cmd}"
    }
}

pipeline {
    agent any

    environment {
        VIRTUAL_ENV = 'venv'
        // Deployment target outside the workspace, so it survives cleanWs()
        DEPLOY_DIR = "${env.JENKINS_HOME}/deployments/Python-CI-CD"
    }

    stages {
        stage('Setup') {
            steps {
                script {
                    // PYTHON can be set in Manage Jenkins > System > Environment variables
                    // when python is not on the Jenkins service's PATH.
                    def py = env.PYTHON ?: (isUnix() ? 'python3' : 'python')
                    if (!fileExists("${env.WORKSPACE}/${VIRTUAL_ENV}")) {
                        if (isUnix()) {
                            sh "${py} -m venv ${VIRTUAL_ENV}"
                        } else {
                            bat "\"${py}\" -m venv ${VIRTUAL_ENV}"
                        }
                    }
                    venv('python -m pip install --upgrade pip')
                    venv('python -m pip install -r requirements.txt')
                }
            }
        }

        stage('Lint') {
            steps {
                script {
                    venv('python -m flake8 app.py deploy.py tests')
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    venv('python -m pytest -v --junitxml=test-results.xml')
                }
            }
        }

        stage('Coverage') {
            steps {
                script {
                    // Settings (source, omit, fail_under = 90) live in .coveragerc
                    venv('python -m coverage run -m pytest -q')
                    venv('python -m coverage report')
                    venv('python -m coverage xml')
                    venv('python -m coverage html')
                }
            }
        }

        stage('Security Scan') {
            steps {
                script {
                    // Save a JSON report, then run again so any issue fails the build
                    venv('python -m bandit app.py deploy.py -f json -o bandit-report.json --exit-zero')
                    venv('python -m bandit app.py deploy.py')
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    echo "Deploying application to ${env.DEPLOY_DIR} ..."
                    venv("python deploy.py --target \"${env.DEPLOY_DIR}\" --build ${env.BUILD_NUMBER}")
                }
            }
        }
    }

    post {
        always {
            junit testResults: 'test-results.xml', allowEmptyResults: true
            archiveArtifacts artifacts: 'coverage.xml, htmlcov/**, bandit-report.json, test-results.xml',
                             allowEmptyArchive: true
            cleanWs()
        }
        success {
            echo 'Pipeline finished: all stages passed.'
        }
        failure {
            echo 'Pipeline failed: check the stage logs above.'
        }
    }
}
